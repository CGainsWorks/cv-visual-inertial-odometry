# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# Datasets are never committed.  scripts/fetch_euroc.py downloads them and
# scripts/make_sim_dataset.py generates the synthetic one.
data/
datasets/
*.bag

# Run outputs.  Everything under results/ is regenerated by
# `make experiments`, except results/published/ which is the committed
# evidence behind the README.
results/*
!results/published/
!results/.gitkeep

# Generated figures.  `make plots` rebuilds them; the ones the README shows
# are committed under docs/plots.
docs/plots/*.pdf

# Trained vocabularies are a few hundred kilobytes and are rebuilt by
# `make vocabulary`, so they are not tracked.
models/*.pkl

# Sparse maps are written next to the trajectories and regenerated with them.
*.ply

# Editors and platforms
.vscode/
.idea/
.DS_Store
Thumbs.db
